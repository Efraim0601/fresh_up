# =============================================================================
# Fresh Up - Variables d'environnement (exemple)
# Copier ce fichier en `.env` a la racine (utilise par docker-compose) et/ou
# dans chaque app (apps/web/.env.local, apps/api/.env, apps/ai-service/.env)
# selon le mode d'execution. Ne JAMAIS committer de vraies valeurs.
# =============================================================================

# --- General -----------------------------------------------------------------
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
AI_SERVICE_BASE_URL=http://localhost:8000

# --- PostgreSQL (apps/api, via Prisma) ---------------------------------------
POSTGRES_USER=freshup
POSTGRES_PASSWORD=freshup_dev_password
POSTGRES_DB=freshup
POSTGRES_PORT=5432
# Chaine complete utilisee par Prisma :
DATABASE_URL=postgresql://freshup:freshup_dev_password@localhost:5432/freshup?schema=public

# --- Auth (apps/api) ----------------------------------------------------------
# Secret JWT (access token) - generer une valeur forte en production
JWT_SECRET=change_me_dev_only_jwt_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_dev_only_jwt_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Stockage S3-compatible (images, textures, GLB) --------------------------
# Dev local: MinIO (voir docker-compose.yml). Prod: OVH Object Storage, Scaleway,
# AWS S3, etc. (tout endpoint compatible S3).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=freshup_minio_admin
S3_SECRET_ACCESS_KEY=freshup_minio_dev_password
S3_BUCKET_FABRICS=fresh-up-fabrics
S3_BUCKET_GARMENTS=fresh-up-garments
S3_BUCKET_RENDERS=fresh-up-renders
S3_FORCE_PATH_STYLE=true
# URL publique de base pour servir les fichiers (CDN ou proxy devant le bucket)
S3_PUBLIC_BASE_URL=http://localhost:9000/fresh-up-fabrics

# --- Service IA (apps/ai-service) --------------------------------------------
AI_SERVICE_PORT=8000
# Backend LLM local pour /ai/parse-outfit (niveau 1). Voir docs/ARCHITECTURE.md.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
# Repli obligatoire si le LLM est indisponible: true active le parseur par regles/mots-cles
AI_PARSE_OUTFIT_FALLBACK_ENABLED=true
# Niveau 2 (phase 3, DESACTIVE en phase 1) - generation d'image d'inspiration
AI_INSPIRATION_ENABLED=false
AI_INSPIRATION_PROVIDER=none
# ex: modal, runpod - non configure en phase 1
AI_INSPIRATION_GPU_PROVIDER_API_KEY=

# --- Paiement (module pluggable, voir docs/ARCHITECTURE.md) ------------------
# DECISION OUVERTE: pays/devise/prestataire de paiement non encore choisis par
# le proprietaire. Provider "mock" par defaut pour dev/phase 1: aucune vraie
# transaction. Ne pas coder en dur un seul prestataire.
PAYMENT_PROVIDER=mock
PAYMENT_CURRENCY=XAF
# A renseigner uniquement si PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A renseigner uniquement si PAYMENT_PROVIDER=orange_money | wave | mtn_momo ...
MOBILE_MONEY_API_BASE_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=

# --- Notifications (phase 2) --------------------------------------------------
NOTIFICATIONS_PROVIDER=none
WHATSAPP_API_TOKEN=
SMS_API_TOKEN=

# --- Front-end (apps/web) -----------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_AI_SERVICE_BASE_URL=http://localhost:8000
NEXT_PUBLIC_S3_PUBLIC_BASE_URL=http://localhost:9000/fresh-up-fabrics
NEXT_PUBLIC_DEFAULT_CURRENCY=XAF
NEXT_PUBLIC_DEFAULT_LOCALE=fr
